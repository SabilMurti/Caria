use std.std_internal {
    regex_test_internal,
    regex_match_internal,
    regex_replace_all_internal
}

/// Test if a string matches a regular expression.
pub fn test(pattern: Str, s: Str) -> Bool {
    ret regex_test_internal(pattern, s)
}

/// Find match details of a string matching a regular expression.
pub fn matchStr(pattern: Str, s: Str) -> List<Str>? {
    ret regex_match_internal(pattern, s)
}

/// Replace all occurrences matching a regex pattern.
pub fn replaceAll(pattern: Str, s: Str, replacement: Str) -> Str {
    ret regex_replace_all_internal(pattern, s, replacement)
}
