use std.std_internal { read_text_internal, write_text_internal, exists_internal }

pub fn readText(path: Str) -> Result<Str, Str> {
    ret read_text_internal(path)
}

pub fn writeText(path: Str, content: Str) -> Result<Nil, Str> {
    ret write_text_internal(path, content)
}

pub fn exists(path: Str) -> Bool {
    ret exists_internal(path)
}
