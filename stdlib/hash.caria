use std.std_internal {
    keys_internal,
    values_internal,
    entries_internal,
    has_key_internal,
    get_or_default_internal
}

/// Get a list of keys from a map.
pub fn keys(map: Map<Any, Any>) -> List<Any> {
    ret keys_internal(map)
}

/// Get a list of values from a map.
pub fn values(map: Map<Any, Any>) -> List<Any> {
    ret values_internal(map)
}

/// Get key-value entries from a map.
pub fn entries(map: Map<Any, Any>) -> List<List<Any>> {
    ret entries_internal(map)
}

/// Check if a map contains a key.
pub fn hasKey(map: Map<Any, Any>, key: Any) -> Bool {
    ret has_key_internal(map, key)
}

/// Get value from a map, returning default if key is not found.
pub fn getOrDefault(map: Map<Any, Any>, key: Any, default_val: Any) -> Any {
    ret get_or_default_internal(map, key, default_val)
}
