use std.std_internal {
    split_internal,
    join_str_internal,
    trim_internal,
    replace_internal,
    contains_internal,
    starts_with_internal,
    ends_with_internal,
    to_lower_internal,
    to_upper_internal
}

/// Split a string by a separator.
pub fn split(s: Str, sep: Str) -> List<Str> {
    ret split_internal(s, sep)
}

/// Join a list of strings by a separator.
pub fn join(parts: List<Str>, sep: Str) -> Str {
    ret join_str_internal(parts, sep)
}

/// Trim whitespace from both ends of a string.
pub fn trim(s: Str) -> Str {
    ret trim_internal(s)
}

/// Replace occurrences of a pattern with a replacement string.
pub fn replace(s: Str, pattern: Str, replacement: Str) -> Str {
    ret replace_internal(s, pattern, replacement)
}

/// Check if a string contains a substring.
pub fn contains(s: Str, sub: Str) -> Bool {
    ret contains_internal(s, sub)
}

/// Check if a string starts with a substring.
pub fn startsWith(s: Str, prefix: Str) -> Bool {
    ret starts_with_internal(s, prefix)
}

/// Check if a string ends with a substring.
pub fn endsWith(s: Str, suffix: Str) -> Bool {
    ret ends_with_internal(s, suffix)
}

/// Convert a string to lowercase.
pub fn toLower(s: Str) -> Str {
    ret to_lower_internal(s)
}

/// Convert a string to uppercase.
pub fn toUpper(s: Str) -> Str {
    ret to_upper_internal(s)
}
