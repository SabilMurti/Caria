use std.std_internal {
    read_dir_internal,
    create_dir_internal,
    remove_file_internal,
    remove_dir_internal
}

/// Read directory contents, returning list of file/directory names.
pub fn readDir(path: Str) -> Result<List<Str>, Str> {
    ret read_dir_internal(path)
}

/// Create a directory.
pub fn createDir(path: Str) -> Result<Nil, Str> {
    ret create_dir_internal(path)
}

/// Remove a file.
pub fn removeFile(path: Str) -> Result<Nil, Str> {
    ret remove_file_internal(path)
}

/// Remove a directory (recursively).
pub fn removeDir(path: Str) -> Result<Nil, Str> {
    ret remove_dir_internal(path)
}
