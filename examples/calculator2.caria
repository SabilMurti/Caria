rune calculate(op: int, a: int, b: int) -> int {
    ret when op {
        1 => a + b,
        2 => a - b,
        3 => a * b,
        4 => a / b,
        else => 0
    }
}

get "/" {
    ret "<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Calesteria Pure Native Button Grid Calculator</title>
    <script src='https://cdn.tailwindcss.com'></script>
    <link href='https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap' rel='stylesheet'>
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: radial-gradient(circle at top right, #1e1b4b, #030712);
        }
    </style>
</head>
<body class='flex flex-col items-center justify-center min-h-screen text-gray-100 px-4 overflow-hidden'>
    <div class='relative w-full max-w-sm bg-gray-900/80 backdrop-blur-xl border border-gray-800 rounded-3xl p-6 shadow-2xl shadow-indigo-950/50'>
        <div class='absolute -top-10 -left-10 w-40 h-40 bg-indigo-600/20 rounded-full blur-3xl -z-10'></div>
        <div class='absolute -bottom-10 -right-10 w-40 h-40 bg-purple-600/20 rounded-full blur-3xl -z-10'></div>

        <div class='flex items-center justify-between mb-6'>
            <span class='text-xs uppercase tracking-widest text-indigo-400 font-semibold'>Calesteria Native SSR</span>
            <span class='text-xs text-green-400 bg-green-950/60 border border-green-800 px-2.5 py-1 rounded-full font-mono'>100% Zero JS Grid</span>
        </div>

        <form method='GET' action='/'>
            <input type='hidden' name='cur' value='{{CUR}}' />
            <input type='hidden' name='prev' value='{{PREV}}' />
            <input type='hidden' name='op' value='{{OP}}' />

            <div class='bg-gray-950/80 border border-gray-800/80 rounded-2xl p-5 mb-6 text-right relative overflow-hidden'>
                <div class='text-xs uppercase text-gray-500 tracking-wider mb-1'>Native OS Display</div>
                <div class='text-4xl font-light tracking-tight text-white transition-all duration-300 truncate'>{{RESULT}}</div>
            </div>

            <div class='grid grid-cols-4 gap-3.5'>
                <button type='submit' name='btn' value='AC' class='col-span-2 py-4 bg-gray-800/60 hover:bg-gray-800 border border-gray-700/50 hover:border-gray-600 rounded-2xl text-gray-200 text-lg font-medium transition-all active:scale-95'>AC</button>
                <button type='submit' name='btn' value='DEL' class='py-4 bg-gray-800/60 hover:bg-gray-800 border border-gray-700/50 hover:border-gray-600 rounded-2xl text-gray-200 text-lg font-medium transition-all active:scale-95'>⌫</button>
                <button type='submit' name='btn' value='DIV' class='py-4 bg-indigo-600/80 hover:bg-indigo-600 rounded-2xl text-white text-xl font-semibold transition-all active:scale-95'>÷</button>

                <button type='submit' name='btn' value='7' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>7</button>
                <button type='submit' name='btn' value='8' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>8</button>
                <button type='submit' name='btn' value='9' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>9</button>
                <button type='submit' name='btn' value='MUL' class='py-4 bg-indigo-600/80 hover:bg-indigo-600 rounded-2xl text-white text-xl font-semibold transition-all active:scale-95'>×</button>

                <button type='submit' name='btn' value='4' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>4</button>
                <button type='submit' name='btn' value='5' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>5</button>
                <button type='submit' name='btn' value='6' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>6</button>
                <button type='submit' name='btn' value='MINUS' class='py-4 bg-indigo-600/80 hover:bg-indigo-600 rounded-2xl text-white text-xl font-semibold transition-all active:scale-95'>−</button>

                <button type='submit' name='btn' value='1' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>1</button>
                <button type='submit' name='btn' value='2' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>2</button>
                <button type='submit' name='btn' value='3' class='py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>3</button>
                <button type='submit' name='btn' value='PLUS' class='py-4 bg-indigo-600/80 hover:bg-indigo-600 rounded-2xl text-white text-xl font-semibold transition-all active:scale-95'>+</button>

                <button type='submit' name='btn' value='0' class='col-span-2 py-4 bg-gray-900 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 rounded-2xl text-white text-xl transition-all active:scale-95'>0</button>
                <button type='submit' name='btn' value='EQ' class='col-span-2 py-4 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 rounded-2xl text-white text-xl font-semibold shadow-lg shadow-indigo-500/20 transition-all active:scale-95'>=</button>
            </div>
        </form>
    </div>

    <div class='mt-8 text-center text-xs text-gray-500 font-mono'>
        <p>100% Calesteria Tech Stack — Pure Compiled Native Binary</p>
        <p class='text-indigo-400 mt-1'>Zero JavaScript, Zero DOM Manipulation, Pure Native SSR</p>
    </div>
</body>
</html>"
}

rune main() -> int {
    ret 0
}
