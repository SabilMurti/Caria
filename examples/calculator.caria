rune calculate(op: int, a: int, b: int) -> int {
    ret when op {
        1 => a + b,
        2 => a - b,
        3 => a * b,
        4 => a / b,
        else => 0
    }
}

get "/" {
    ret "<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Calesteria Pure Native Calculator</title>
    <script src='https://cdn.tailwindcss.com'></script>
    <link href='https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap' rel='stylesheet'>
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: radial-gradient(circle at top right, #1e1b4b, #030712);
        }
    </style>
</head>
<body class='flex flex-col items-center justify-center min-h-screen text-gray-100 px-4 overflow-hidden'>
    <div class='relative w-full max-w-md bg-gray-900/80 backdrop-blur-xl border border-gray-800 rounded-3xl p-8 shadow-2xl shadow-indigo-950/50'>
        <div class='absolute -top-10 -left-10 w-40 h-40 bg-indigo-600/20 rounded-full blur-3xl -z-10'></div>
        <div class='absolute -bottom-10 -right-10 w-40 h-40 bg-purple-600/20 rounded-full blur-3xl -z-10'></div>

        <div class='flex items-center justify-between mb-6'>
            <span class='text-xs uppercase tracking-widest text-indigo-400 font-semibold'>Calesteria Native SSR</span>
            <span class='text-xs text-green-400 bg-green-950/60 border border-green-800 px-2.5 py-1 rounded-full font-mono'>100% Zero JS</span>
        </div>

        <div class='bg-gray-950/80 border border-gray-800/80 rounded-2xl p-6 mb-6 text-center relative overflow-hidden'>
            <div class='text-xs uppercase text-gray-500 tracking-wider mb-1'>Hasil Perhitungan Native</div>
            <div class='text-4xl font-light tracking-tight text-indigo-400 truncate'>{{RESULT}}</div>
        </div>

        <form method='GET' action='/' class='space-y-4'>
            <div>
                <label class='block text-xs text-gray-400 uppercase tracking-wider mb-1'>Angka Pertama (A)</label>
                <input type='number' name='a' value='10' class='w-full bg-gray-950 border border-gray-800 rounded-xl px-4 py-3 text-white text-lg focus:outline-none focus:border-indigo-500 transition-colors' required />
            </div>

            <div>
                <label class='block text-xs text-gray-400 uppercase tracking-wider mb-1'>Operasi Matematika</label>
                <select name='op' class='w-full bg-gray-950 border border-gray-800 rounded-xl px-4 py-3 text-white text-lg focus:outline-none focus:border-indigo-500 transition-colors'>
                    <option value='1'>+ (Penjumlahan)</option>
                    <option value='2'>- (Pengurangan)</option>
                    <option value='3'>* (Perkalian)</option>
                    <option value='4'>/ (Pembagian)</option>
                </select>
            </div>

            <div>
                <label class='block text-xs text-gray-400 uppercase tracking-wider mb-1'>Angka Kedua (B)</label>
                <input type='number' name='b' value='20' class='w-full bg-gray-950 border border-gray-800 rounded-xl px-4 py-3 text-white text-lg focus:outline-none focus:border-indigo-500 transition-colors' required />
            </div>

            <button type='submit' class='w-full mt-2 py-4 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 rounded-xl text-white text-lg font-semibold shadow-lg shadow-indigo-500/20 transition-all duration-150 active:scale-95'>
                Hitung via Calesteria OS Binary
            </button>
        </form>
    </div>

    <div class='mt-8 text-center text-xs text-gray-500 font-mono'>
        <p>100% Calesteria Native Compiled Web Binary</p>
        <p class='text-indigo-400 mt-1'>Zero JavaScript Tags — Pure Server Side Execution</p>
    </div>
</body>
</html>"
}

rune main() -> int {
    ret 0
}
