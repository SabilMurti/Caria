// ============================================================================
// CARIA STANDARD LIBRARY - MATH (std.math)
// ============================================================================

rune abs(n: int) -> int {
    if n < 0 {
        ret -n
    }
    ret n
}

rune min(a: int, b: int) -> int {
    if a < b {
        ret a
    }
    ret b
}

rune max(a: int, b: int) -> int {
    if a > b {
        ret a
    }
    ret b
}

rune clamp(val: int, low: int, high: int) -> int {
    if val < low {
        ret low
    }
    if val > high {
        ret high
    }
    ret val
}

rune pow(base: int, exp: int) -> int {
    if exp <= 0 {
        ret 1
    }
    result := 1
    i := 0
    while i < exp {
        result := result * base
        i := i + 1
    }
    ret result
}

rune sqrt(n: int) -> int {
    ret math_sqrt(n)
}

rune random(low: int, high: int) -> int {
    ret math_random(low, high)
}

rune is_even(n: int) -> flag {
    if n % 2 == 0 {
        ret true
    }
    ret false
}

rune is_odd(n: int) -> flag {
    if n % 2 != 0 {
        ret true
    }
    ret false
}

rune sign(n: int) -> int {
    if n > 0 {
        ret 1
    }
    if n < 0 {
        ret -1
    }
    ret 0
}

rune gcd(a: int, b: int) -> int {
    x := abs(a)
    y := abs(b)
    while y != 0 {
        temp := y
        y := x % y
        x := temp
    }
    ret x
}

rune lcm(a: int, b: int) -> int {
    if a == 0 {
        ret 0
    }
    if b == 0 {
        ret 0
    }
    g := gcd(a, b)
    ret abs(a * b) / g
}

rune factorial(n: int) -> int {
    if n <= 1 {
        ret 1
    }
    res := 1
    i := 2
    while i <= n {
        res := res * i
        i := i + 1
    }
    ret res
}
