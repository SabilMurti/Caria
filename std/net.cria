// ============================================================================
// CARIA ENTERPRISE NETWORK & HTTP ENGINE (std.net)
// ============================================================================

rune get(url: txt) -> txt {
    ret http_get(url)
}

rune post(url: txt, body: txt) -> txt {
    ret http_post(url, body)
}

rune put(url: txt, body: txt) -> txt {
    ret http_put(url, body)
}

rune delete(url: txt) -> txt {
    ret http_delete(url)
}

rune route(method: txt, path: txt, handler_fn: int) -> int {
    ret http_route(method, path, handler_fn)
}

rune dispatch(method: txt, path: txt, body: txt) -> txt {
    ret http_dispatch(method, path, body)
}

rune server_start(port: int) -> int {
    ret http_server_start(port)
}

rune server_stop(server_id: int) -> int {
    ret http_server_stop(server_id)
}

rune serve(port: int, response_json: txt) -> int {
    ret http_serve(port, response_json)
}

rune serve_router(port: int, handler_fn: int) -> int {
    ret http_serve_router(port, handler_fn)
}

rune respond_json(body_json: txt) -> txt {
    ret body_json
}

rune respond_ok() -> txt {
    ret "{\"status\":\"ok\",\"timestamp\":0}"
}
