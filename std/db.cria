// ============================================================================
// CARIA STANDARD LIBRARY - DATABASE (SQLITE)
// ============================================================================

rune db_open(path: txt) -> int {
    // Calls native FFI caria_sqlite_open
    ret 1
}

rune db_close(conn_id: int) -> int {
    // Calls native FFI caria_sqlite_close
    ret 0
}

rune db_exec(conn_id: int, sql: txt) -> int {
    // Calls native FFI caria_sqlite_exec
    ret 0
}

rune db_query(conn_id: int, sql: txt) -> txt {
    // Calls native FFI caria_sqlite_query, returns JSON array string
    ret "[]"
}
