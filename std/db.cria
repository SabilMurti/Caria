// ============================================================================
// CARIA STANDARD LIBRARY - DATABASE (SQLITE)
// ============================================================================

rune open(path: txt) -> int {
    ret db_open(path)
}

rune close(conn_id: int) -> int {
    ret db_close(conn_id)
}

rune exec(conn_id: int, sql: txt) -> int {
    ret db_exec(conn_id, sql)
}

rune query(conn_id: int, sql: txt) -> txt {
    ret db_query(conn_id, sql)
}
