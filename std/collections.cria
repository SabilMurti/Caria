// ============================================================================
// CARIA STANDARD LIBRARY - COLLECTIONS (std.collections)
// ============================================================================

rune range(start: int, stop: int) -> [int] {
    items := []
    i := start
    while i < stop {
        array_push(items, i)
        i := i + 1
    }
    ret items
}

rune contains_int(arr: [int], target: int) -> flag {
    for item in arr {
        if item == target {
            ret true
        }
    }
    ret false
}

rune sum(arr: [int]) -> int {
    total := 0
    for item in arr {
        total := total + item
    }
    ret total
}

rune first(arr: [int]) -> int {
    if arr.len > 0 {
        ret arr[0]
    }
    ret 0
}

rune last(arr: [int]) -> int {
    count := arr.len
    if count > 0 {
        ret arr[count - 1]
    }
    ret 0
}

rune max_val(arr: [int]) -> int {
    if arr.len == 0 {
        ret 0
    }
    m := arr[0]
    for item in arr {
        if item > m {
            m := item
        }
    }
    ret m
}

rune min_val(arr: [int]) -> int {
    if arr.len == 0 {
        ret 0
    }
    m := arr[0]
    for item in arr {
        if item < m {
            m := item
        }
    }
    ret m
}

rune count(arr: [int], target: int) -> int {
    c := 0
    for item in arr {
        if item == target {
            c := c + 1
        }
    }
    ret c
}

rune reverse(arr: [int]) -> [int] {
    res := []
    idx := arr.len - 1
    while idx >= 0 {
        array_push(res, arr[idx])
        idx := idx - 1
    }
    ret res
}
