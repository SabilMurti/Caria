{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Caria",
    "scopeName": "source.caria",
    "fileTypes": [
        ".cria"
    ],
    "patterns": [
        {
            "include": "#shebang"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#regex_literals"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#http_verbs"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#variable_declarations"
        },
        {
            "include": "#function_declarations"
        },
        {
            "include": "#function_calls"
        },
        {
            "include": "#model_declarations"
        },
        {
            "include": "#route_declarations"
        },
        {
            "include": "#block_labels"
        },
        {
            "include": "#builtin_functions"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#units"
        },
        {
            "include": "#property_access"
        },
        {
            "include": "#html_views"
        }
    ],
    "repository": {
        "shebang": {
            "patterns": [
                {
                    "name": "comment.line.shebang.caria",
                    "match": "^#!.*"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.documentation.caria",
                    "match": "///.*$"
                },
                {
                    "name": "comment.block.caria",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.line.double-slash.caria",
                    "match": "//.*$"
                }
            ]
        },
        "regex_literals": [
            {
                "name": "string.regexp.caria",
                "begin": "\\br\"",
                "end": "\"",
                "patterns": [
                    {
                        "name": "constant.character.escape.caria",
                        "match": "\\\\\\\\."
                    }
                ]
            }
        ],
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.caria",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.caria",
                            "match": "\\\\\\\\[nrt0\"\\\\\\\\]"
                        },
                        {
                            "name": "constant.character.escape.hex.caria",
                            "match": "\\\\\\\\x[0-9a-fA-F]{2}"
                        },
                        {
                            "name": "constant.character.escape.unicode.caria",
                            "match": "\\\\\\\\u[0-9a-fA-F]{4}"
                        },
                        {
                            "name": "meta.interpolation.caria",
                            "begin": "\\{",
                            "end": "\\}",
                            "patterns": [
                                {
                                    "include": "#expression_inside"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.caria",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.caria",
                            "match": "\\\\\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.template.caria",
                    "begin": "`",
                    "end": "`",
                    "patterns": [
                        {
                            "name": "constant.character.escape.caria",
                            "match": "\\\\\\\\.+"
                        },
                        {
                            "name": "meta.interpolation.caria",
                            "begin": "\\$\\{",
                            "end": "\\}",
                            "patterns": [
                                {
                                    "include": "#expression_inside"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "expression_inside": {
            "patterns": [
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#function_calls"
                },
                {
                    "include": "#builtin_functions"
                },
                {
                    "include": "#property_access"
                },
                {
                    "include": "#variable_declarations"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.caria",
                    "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
                },
                {
                    "name": "constant.numeric.hex.caria",
                    "match": "\\b0x[0-9a-fA-F_]+\\b"
                },
                {
                    "name": "constant.numeric.binary.caria",
                    "match": "\\b0b[01_]+\\b"
                },
                {
                    "name": "constant.numeric.octal.caria",
                    "match": "\\b0o[0-7_]+\\b"
                },
                {
                    "name": "constant.numeric.integer.caria",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.caria",
                    "match": "\\b(rune|ret|if|else|for|in|while|when|break|continue|return|defer|guard|unless|parallel|spawn|times|retry|timeout|transaction|as|step|is|fallthrough)\\b"
                },
                {
                    "name": "keyword.declaration.caria",
                    "match": "\\b(static|pub|abstract|override|virtual|inline|mut|let|const|var|import|from|summon)\\b"
                },
                {
                    "name": "keyword.other.caria",
                    "match": "\\b(component|model|style|client|view|middleware|service|provider|trait|interface|enum|struct|type|alias|module|namespace)\\b"
                },
                {
                    "name": "keyword.control.flow.caria",
                    "match": "\\b(emit|broadcast|on_connect|on_message|on_disconnect|on_error|subscribe|unsubscribe|publish)\\b"
                },
                {
                    "name": "keyword.operator.logical.caria",
                    "match": "\\b(and|or|not|mod|div|is|as)\\b"
                },
                {
                    "name": "keyword.concurrency.caria",
                    "match": "\\b(parallel|spawn|channel|select|go|async|await|yield|race)\\b"
                },
                {
                    "name": "keyword.pipeline.caria",
                    "match": "\\b(with|validate|through|then|pipe|send|handle)\\b"
                }
            ]
        },
        "http_verbs": [
            {
                "name": "keyword.http.verb.caria",
                "match": "^(\\s*)(get|post|put|delete|patch|options|head|socket|stream)(\\s+)(\"/[^\"]*\")",
                "captures": {
                    "1": {
                        "name": "text.caria"
                    },
                    "2": {
                        "name": "entity.name.function.http.caria"
                    },
                    "3": {
                        "name": "text.caria"
                    },
                    "4": {
                        "name": "string.quoted.double.caria string.route-path.caria"
                    }
                }
            }
        ],
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.caria",
                    "match": "\\b(int|dec|txt|flag|void|any|never)\\b"
                },
                {
                    "name": "storage.type.complex.caria",
                    "match": "\\b(String|Int|Float|Bool|Map|List|Set|Result|Option|Any|Function|Promise|Error|Buffer|Stream|Bytes)\\b"
                },
                {
                    "name": "storage.type.generic.caria",
                    "match": "\\b(Result|Option|Map|List|Array|Iterable|Future|Stream)<[^>]+>\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.caria",
                    "match": "\\b(true|false|nil|none|null|undefined|infinity|nan)\\b"
                },
                {
                    "name": "constant.other.color.caria",
                    "match": "#[0-9a-fA-F]{3}(?:[0-9a-fA-F]{3})?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.caria",
                    "match": ":="
                },
                {
                    "name": "keyword.operator.arrow.caria",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.pipe.caria",
                    "match": "\\|>"
                },
                {
                    "name": "keyword.operator.null-coalesce.caria",
                    "match": "\\?="
                },
                {
                    "name": "keyword.operator.range.caria",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.optional.caria",
                    "match": "\\?\\."
                },
                {
                    "name": "keyword.operator.return.caria",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.comparison.caria",
                    "match": "===?|!==?|<=|>=|<|>|!=|==|!|=="
                },
                {
                    "name": "keyword.operator.arithmetic.caria",
                    "match": "[+\\-*/%!&|^~]"
                }
            ]
        },
        "variable_declarations": {
            "patterns": [
                {
                    "name": "meta.variable.mutable.caria",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:=)",
                    "captures": {
                        "1": {
                            "name": "variable.other.mutable.caria"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.caria"
                        }
                    }
                },
                {
                    "name": "meta.variable.immutable.caria",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?<![=!<>])=(?!=|>)",
                    "captures": {
                        "1": {
                            "name": "variable.other.immutable.caria"
                        }
                    }
                }
            ]
        },
        "function_declarations": {
            "patterns": [
                {
                    "name": "meta.function.caria",
                    "match": "\\b(rune)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
                    "captures": {
                        "1": {
                            "name": "keyword.control.caria keyword.rune.caria"
                        },
                        "2": {
                            "name": "entity.name.function.caria"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.caria"
                        }
                    }
                },
                {
                    "name": "meta.function.inline.caria",
                    "match": "\\b(rune)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.caria keyword.rune.caria"
                        },
                        "2": {
                            "name": "entity.name.function.caria"
                        }
                    }
                }
            ]
        },
        "function_calls": {
            "patterns": [
                {
                    "name": "meta.function-call.caria",
                    "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.caria support.function.builtin.caria"
                        },
                        "2": {
                            "name": "punctuation.definition.arguments.begin.caria"
                        }
                    }
                },
                {
                    "name": "meta.method-call.caria",
                    "match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.caria"
                        },
                        "2": {
                            "name": "entity.name.function.method.caria"
                        },
                        "3": {
                            "name": "punctuation.definition.arguments.begin.caria"
                        }
                    }
                }
            ]
        },
        "model_declarations": [
            {
                "name": "meta.model.caria",
                "begin": "\\b(model)\\s+([A-Z][a-zA-Z0-9_]*)\\s*\\{",
                "beginCaptures": {
                    "1": {
                        "name": "keyword.other.caria keyword.model.caria"
                    },
                    "2": {
                        "name": "entity.name.type.model.caria"
                    }
                },
                "end": "\\}",
                "endCaptures": {
                    "0": {
                        "name": "punctuation.definition.block.end.caria"
                    }
                },
                "patterns": [
                    {
                        "include": "#comments"
                    },
                    {
                        "include": "#strings"
                    },
                    {
                        "include": "#types"
                    },
                    {
                        "include": "#constants"
                    },
                    {
                        "include": "#numbers"
                    },
                    {
                        "name": "meta.model.field.caria",
                        "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
                        "captures": {
                            "1": {
                                "name": "variable.other.field.caria"
                            }
                        }
                    },
                    {
                        "name": "meta.model.field-attribute.caria",
                        "match": "\\[(unique|index|primary|foreign|nullable|encrypted|hidden|hashed|unsigned|auto_increment|default|required|optional)\\]",
                        "captures": {
                            "1": {
                                "name": "storage.modifier.attribute.caria"
                            }
                        }
                    },
                    {
                        "include": "#function_declarations"
                    },
                    {
                        "include": "#keywords"
                    },
                    {
                        "include": "#operators"
                    }
                ]
            }
        ],
        "route_declarations": [
            {
                "name": "meta.route.declaration.caria",
                "begin": "\\b(get|post|put|delete|patch|options|head|socket|stream)\\s+(\"/[^\"]*\")",
                "beginCaptures": {
                    "1": {
                        "name": "entity.name.function.http.caria"
                    },
                    "2": {
                        "name": "string.quoted.double.caria string.route-path.caria"
                    }
                },
                "end": "(?<=\\})",
                "patterns": [
                    {
                        "name": "meta.route.with-clause.caria",
                        "match": "\\b(with)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\([^)]*\\))?)",
                        "captures": {
                            "1": {
                                "name": "keyword.pipeline.caria"
                            },
                            "2": {
                                "name": "entity.name.function.middleware.caria"
                            }
                        }
                    },
                    {
                        "include": "#comments"
                    },
                    {
                        "include": "#strings"
                    },
                    {
                        "include": "#keywords"
                    },
                    {
                        "include": "#types"
                    },
                    {
                        "include": "#constants"
                    },
                    {
                        "include": "#numbers"
                    },
                    {
                        "include": "#function_calls"
                    },
                    {
                        "include": "#builtin_functions"
                    },
                    {
                        "include": "#operators"
                    },
                    {
                        "include": "#variable_declarations"
                    },
                    {
                        "include": "#function_declarations"
                    },
                    {
                        "name": "meta.route.path-param.caria",
                        "match": "\\{([a-zA-Z_][a-zA-Z0-9_]*)\\s*:\\s*(int|dec|txt|flag|uuid|slug|any)\\}",
                        "captures": {
                            "1": {
                                "name": "variable.parameter.route.caria"
                            },
                            "2": {
                                "name": "storage.type.primitive.caria"
                            }
                        }
                    }
                ]
            }
        ],
        "block_labels": {
            "patterns": [
                {
                    "name": "meta.block-style.caria",
                    "match": "\\b(style)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(\\()",
                    "captures": {
                        "1": {
                            "name": "keyword.other.caria"
                        },
                        "2": {
                            "name": "entity.name.type.style.caria"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.caria"
                        }
                    }
                },
                {
                    "name": "meta.block-client.caria",
                    "match": "\\b(client)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\{",
                    "captures": {
                        "1": {
                            "name": "keyword.other.caria"
                        },
                        "2": {
                            "name": "entity.name.function.client.caria"
                        }
                    }
                },
                {
                    "name": "meta.block-component.caria",
                    "match": "\\b(component)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(\\()",
                    "captures": {
                        "1": {
                            "name": "keyword.other.caria"
                        },
                        "2": {
                            "name": "entity.name.type.component.caria"
                        },
                        "3": {
                            "name": "punctuation.definition.parameters.begin.caria"
                        }
                    }
                }
            ]
        },
        "builtin_functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.caria",
                    "match": "\\b(say|say\\.info|say\\.error|say\\.warn|say\\.debug|say\\.success)\\b"
                },
                {
                    "name": "support.function.builtin.caria",
                    "match": "\\b(print|println|assert|panic|recover|len|cap|append|copy|delete|close|make|new|typeof|is_type)\\b"
                },
                {
                    "name": "support.function.builtin.caria",
                    "match": "\\b(http|fetch|get_json|post_json|request|response|json|xml|html|text|redirect|stream|event|cache|env|config|logger|logger\\.info|logger\\.error|logger\\.warn|logger\\.debug)\\b"
                },
                {
                    "name": "support.function.builtin.caria",
                    "match": "\\b(uuid_generate|uuid_parse|uuid_to_string|caria_log_write|caria_time_now|caria_time_format|caria_http_parse|caria_json_stringify|caria_json_parse|caria_foo_)\\b"
                },
                {
                    "name": "support.function.builtin.crypto.caria",
                    "match": "\\b(hash|hash_sha256|hash_md5|hash_hmac|encrypt|decrypt|base64_encode|base64_decode|random_bytes|random_int)\\b"
                }
            ]
        },
        "attributes": {
            "patterns": [
                {
                    "name": "meta.decorator.caria",
                    "match": "@([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.decorator.caria"
                        }
                    }
                },
                {
                    "name": "meta.attribute.caria",
                    "match": "#\\[([a-zA-Z_][a-zA-Z0-9_]*)\\]",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.attribute.caria"
                        }
                    }
                }
            ]
        },
        "units": {
            "patterns": [
                {
                    "name": "constant.numeric.unit.caria",
                    "match": "\\b[0-9]+\\s*(?:s|ms|us|ns|min|h|d|w|mo|y|b|kb|mb|gb|tb|B|KB|MB|GB|TB|rpm|rps|tps|percent|%)\\b"
                }
            ]
        },
        "property_access": {
            "patterns": [
                {
                    "name": "keyword.operator.accessor.caria",
                    "match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\b(?!\\s*\\())",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.caria"
                        },
                        "2": {
                            "name": "variable.other.property.caria"
                        }
                    }
                }
            ]
        },
        "html_views": {
            "patterns": [
                {
                    "name": "meta.view-html.caria",
                    "begin": "(<)([a-zA-Z_][a-zA-Z0-9_]*)(?=[^>]*/?>)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.definition.tag.begin.caria"
                        },
                        "2": {
                            "name": "entity.name.tag.caria"
                        }
                    },
                    "end": "(>)",
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.tag.end.caria"
                        }
                    },
                    "patterns": [
                        {
                            "name": "entity.other.attribute-name.caria",
                            "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(=)",
                            "captures": {
                                "1": {
                                    "name": "entity.other.attribute-name.caria"
                                },
                                "2": {
                                    "name": "punctuation.definition.attribute.caria"
                                }
                            }
                        },
                        {
                            "name": "string.quoted.double.caria",
                            "begin": "\"",
                            "end": "\"",
                            "patterns": [
                                {
                                    "name": "constant.character.escape.caria",
                                    "match": "\\\\\\\\.+"
                                },
                                {
                                    "name": "meta.interpolation.caria",
                                    "begin": "\\{",
                                    "end": "\\}",
                                    "patterns": [
                                        {
                                            "include": "#expression_inside"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "name": "meta.for-directive.caria",
                            "match": "\\b(for)\\s*=\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                            "captures": {
                                "1": {
                                    "name": "keyword.control.caria"
                                },
                                "2": {
                                    "name": "variable.other.caria"
                                },
                                "3": {
                                    "name": "keyword.control.caria"
                                },
                                "4": {
                                    "name": "variable.other.caria"
                                }
                            }
                        },
                        {
                            "name": "meta.if-directive.caria",
                            "match": "\\b(if|unless|class-active|disabled|selected|checked|hidden|readonly)\\s*=\\s*([a-zA-Z_][a-zA-Z0-9_.]*)",
                            "captures": {
                                "1": {
                                    "name": "keyword.control.caria"
                                },
                                "2": {
                                    "name": "variable.other.caria"
                                }
                            }
                        }
                    ]
                },
                {
                    "name": "meta.interpolation.html.caria",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "#expression_inside"
                        }
                    ]
                }
            ]
        }
    }
}