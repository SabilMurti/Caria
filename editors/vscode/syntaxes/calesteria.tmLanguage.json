{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Calesteria",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#functions"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.documentation.caria",
                    "match": "///.*$"
                },
                {
                    "name": "comment.line.double-slash.caria",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.caria",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.caria",
                            "match": "\\\\."
                        },
                        {
                            "name": "meta.interpolation.caria",
                            "begin": "\\{",
                            "end": "\\}",
                            "patterns": [
                                {
                                    "include": "$self"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.caria",
                    "match": "\\b(fn|let|mut|ret|pub|mod|use|if|else|match|for|while|in|break|route|view|query|serve|state|test)\\b"
                },
                {
                    "name": "keyword.operator.logical.caria",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "keyword.operator.caria",
                    "match": "(\\+|\\-|\\*|/|%|=|==|!=|<|>|<=|>=|\\?\\.|\\?\\?|->|\\?)"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "entity.name.type.caria",
                    "match": "\\b(Int|Float|Str|Bool|Nil|List|Map|Set|Result|Any|Function)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.caria",
                    "match": "\\b(true|false|nil)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.caria",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.caria",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.caria"
                        }
                    }
                }
            ]
        }
    },
    "scopeName": "source.caria"
}
