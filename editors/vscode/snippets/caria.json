{
    "Rune": {
        "prefix": "rune",
        "body": [
            "rune ${1:name}(${2}) {",
            "\t$0",
            "}"
        ],
        "description": "Create a new rune (function)"
    },
    "Model": {
        "prefix": "model",
        "body": [
            "model ${1:Name} {",
            "\t$0",
            "}"
        ],
        "description": "Create a new model"
    },
    "Say": {
        "prefix": "say",
        "body": [
            "say(${1});$0"
        ],
        "description": "Print to console"
    },
    "If": {
        "prefix": "if",
        "body": [
            "if (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "If statement"
    }
}
